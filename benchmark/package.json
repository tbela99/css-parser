{
  "name": "css-parser-minify-benchmark",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "sizes": "node src/compute-sizes.js",
    "bench": "vitest bench --run --reporter=json --outputFile=results/bench-results.json",
    "report": "node src/generate-report.js",
    "all": "npm run sizes && npm run bench; npm run report"
  },
  "dependencies": {
    "@tbela99/css-parser": "github:tbela99/css-parser#v2.0.1",
    "@tbela99/css-parser2": "github:tbela99/css-parser#d237344",
    "clean-css": "^5.3.3",
    "css-tree": "^3.2.1",
    "cssnano": "^9.9.0",
    "csso": "^5.0.5",
    "esbuild": "^0.28.2",
    "lightningcss": "^1.33.0",
    "postcss": "^8.5.33",
    "vitest": "^5.1.0",
    "yuku-css": "^0.2.0"
  }
}