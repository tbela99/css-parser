{
  "name": "css-parser-minify-benchmark",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "sizes": "node src/compute-sizes.js",
    "bench": "vitest bench --run --reporter=json --outputFile=results/bench-results.json",
    "report": "node src/generate-report.js",
    "all": "npm run sizes && npm run bench; npm run report",
    "dev:update": "cd .. && npm run build && npm pack --pack-destination benchmark/.packages && cd benchmark && mv .packages/tbela99-css-parser-*.tgz .packages/css-parser.tgz && bun add @tbela99/css-parser2@file:.packages/css-parser.tgz"
  },
  "dependencies": {
    "@stacksjs/ts-css": "^0.3.29",
    "@tbela99/css-parser": "github:tbela99/css-parser#a539754",
    "@tbela99/rust-css-parser-napi": "../../rust-css-parser/extensions/css-parser-napi",
    "@tbela99/rust-css-parser-wasm": "../../rust-css-parser/extensions/css-parser-wasm",
    "clean-css": "^5.3.3",
    "css-tree": "^3.2.1",
    "cssnano": "^9.9.0",
    "csso": "^5.0.5",
    "esbuild": "^0.28.2",
    "lightningcss": "^1.33.0",
    "postcss": "^8.5.33",
    "vitest": "5.1.2",
    "yuku-css": "^0.2.0"
  }
}
